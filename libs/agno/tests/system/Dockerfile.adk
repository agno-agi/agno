FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Google ADK and dependencies
# google-adk 2.5+ serves A2A v1.0 on a2a-sdk 1.x
# The [http-server] extra pulls sse-starlette, which google-adk's to_a2a() requires
RUN pip install --no-cache-dir "google-adk>=2.5" "a2a-sdk[http-server]>=1.2.2,<2" uvicorn

# Copy the server script
COPY tests/system/adk_server.py /app/adk_server.py

# Expose port
EXPOSE 7003

# Health check - ADK servers serve their Agent Card at the root
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:7003/.well-known/agent-card.json || exit 1

CMD ["python", "adk_server.py"]
